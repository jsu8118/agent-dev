# Copy to .env and fill in. .env is git-ignored.
# With a key set, labs call the real Claude API ("live" mode).
# Without one, labs run against labkit's local mock API ("mock" mode) - free and offline.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# LABKIT_MODE=auto               # auto | live | mock
# LABKIT_MODEL=claude-opus-5     # main model used by the labs
# LABKIT_MID_MODEL=claude-sonnet-5
# LABKIT_FAST_MODEL=claude-haiku-4-5
# LABKIT_QUIET=0                 # 1 = don't print the per-run cost summary
